{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,node_modules/**,dist/**,src/**,public/**,.git/**,.env*}"
    }
  }
}
